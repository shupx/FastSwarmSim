<?xml version="1.0"?>
<package format="3">
  <name>fastswarm_px4_sim</name>
  <version>0.1.0</version>
  <description>ROS 2 PX4/MAVROS-compatible drone simulators for FastSwarmSim.</description>
  <maintainer email="shupeixuan@qq.com">Peixuan Shu</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>fastswarm_time</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
