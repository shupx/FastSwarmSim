<?xml version="1.0"?>
<package format="3">
  <name>fss_time_interfaces</name>
  <version>0.1.1</version>
  <description>Distributed simulation time interfaces for FastSwarmSim.</description>
  <maintainer email="shupeixuan@qq.com">Peixuan Shu</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>builtin_interfaces</depend>
